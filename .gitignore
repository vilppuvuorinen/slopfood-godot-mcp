bin/
# Coverage artifacts, regenerated by `make test` / `make e2e-cover` and removed
# by `make clean`. They are never committed; rerun the target before reading.
# The .out profiles are already covered by the *.out rule below.
coverage-*.info
coverage-e2e/
coverage-gdscript/
.godot/
__pycache__/
*.pyc
*.out
*.test
*.prof

.env
.env.*
!.env.example

scratch/*
!scratch/.gitkeep
